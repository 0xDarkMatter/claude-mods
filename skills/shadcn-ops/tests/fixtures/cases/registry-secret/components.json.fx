{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/index.css",
    "baseColor": "neutral",
    "cssVariables": true
  },
  "iconLibrary": "lucide",
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "registries": {
    "@private": {
      "url": "http://registry.example.com/r/{name}.json?token=FIXTURE-URL-SECRET",
      "headers": {
        "Authorization": "Bearer FIXTURE-LITERAL-VALUE"
      }
    }
  }
}
