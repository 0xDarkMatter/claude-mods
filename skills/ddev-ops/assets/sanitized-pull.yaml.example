# Pull-only DDEV provider recipe for a SANITISED database dump.
#
# Copy to .ddev/providers/<name>.yaml (the file name becomes `ddev pull <name>`), fill in
# dburl, then:
#   ddev auth ssh -f ~/.ssh/<one-key-scoped-to-the-dump-host>
#   ddev pull <name>
#
# Adapted from DDEV's rsync.yaml.example (pkg/ddevapp/dotddev_assets/providers, v1.25.4).
# Deliberate differences - keep them:
#   * NO db_push_command / files_push_command. `ddev push` overwrites the upstream
#     database and files; a recipe that can reach production must not be able to push.
#   * It pulls an artifact that was ANONYMISED WHERE THE DATA LIVES (a scheduled job on
#     the server or a staging copy). Sanitising after download is too late: the personal
#     data has already reached the laptop. See references/database.md.
#   * NO files_pull_command, on purpose. With no stanza DDEV prints "No files_pull_command
#     provided, so skipping files pull" and leaves local uploads alone. A stanza that
#     downloads NOTHING is dangerous: DDEV still imports the (empty) .downloads/files
#     folder, and its import EMPTIES the upload directory first, wiping local uploads
#     (DDEV v1.25.4 provider.go doFilesPullCommand/doFilesImport, ImportFiles). Add a
#     files stanza only when it always fetches a real, curated archive.
#   * The dburl guard refuses a path that does not name a sanitised dump - a speed bump
#     against pointing the recipe at a raw production backup. Name the dump file
#     accordingly rather than editing the guard away.
#
# This file does not carry DDEV's generated-file marker, so DDEV never overwrites it.

environment_variables:
  # user@host:path of the sanitised dump, written upstream by e.g. smile/gdpr-dump.
  dburl: deploy@dump-host.example.com:dumps/sanitised.sql.gz

auth_command:
  command: |
    set -eu -o pipefail
    ssh-add -l >/dev/null || { echo "Run 'ddev auth ssh -f <key>' first." >&2; exit 1; }

db_pull_command:
  command: |
    # set -x   # uncomment to trace
    set -eu -o pipefail
    case "${dburl}" in
      *sanitised*|*sanitized*|*anonymised*|*anonymized*) ;;
      *) echo "Refusing: dburl does not name a sanitised dump (${dburl})." >&2; exit 1 ;;
    esac
    rsync -az "${dburl}" /var/www/html/.ddev/.downloads/db.sql.gz
  service: web
