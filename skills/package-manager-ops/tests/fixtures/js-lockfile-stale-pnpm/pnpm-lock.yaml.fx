lockfileVersion: '9.0'

settings:
  autoInstallPeers: true
  excludeLinksFromLockfile: false

importers:

  .:
    devDependencies:
      sass:
        specifier: ^1.93.2
        version: 1.93.2
      vite:
        specifier: ^8.0.10
        version: 8.0.10

packages:

  sass@1.93.2:
    resolution: {integrity: sha512-fixture}
    engines: {node: '>=14.0.0'}
    hasBin: true

  vite@8.0.10:
    resolution: {integrity: sha512-fixture}
    hasBin: true
